  "faq": {
    "title": "Frequently Asked Questions",
    "subtitle": "Get answers about tarot readings.",
    "items": {
      "therapeuticTarot": {
        "question": "What is therapeutic tarot?",
        "answer": "Therapeutic tarot is a self-knowledge tool that uses cards for reflection and guidance, not as a prediction of the future, but as a mirror to better understand situations and possibilities."
      },
      "readingByQuestions": {
        "question": "How does reading by questions work?",
        "answer": "You send your questions through the platform. I do the card spread and prepare a detailed interpretation in PDF, which is available in your client area within 48 hours."
      },
      "experience": {
        "question": "Do I need experience with tarot?",
        "answer": "No! The readings are done in a clear and accessible way. You don't need any prior knowledge about tarot or the Lenormand deck."
      },
      "recording": {
        "question": "Are online sessions recorded?",
        "answer": "Yes, with your permission, online sessions can be recorded so you can review the guidance later."
      },
      "validity": {
        "question": "What is the validity of the reading?",
        "answer": "Readings are available in your client area for 1 year after publication."
      },
      "topics": {
        "question": "Can I ask questions about any topic?",
        "answer": "Readings can cover areas such as professional, relationships, emotional health and personal growth. We avoid questions about physical health, legal matters or third parties."
      }
    }
  },
